Cell[BoxData[
 RowBox[{"eqn1", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["c", "AR"], "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{
     RowBox[{"-", "k"}], " ", 
     RowBox[{
      SubscriptBox["c", "AR"], "[", "t", "]"}]}]}], "}"}]}]], "Input",
