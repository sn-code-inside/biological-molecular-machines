Cell[TextData[{
 "In contrast to the standard textbook system, in which substrate binding is \
equilibrated infinitely fast (and consequently treaded as a simple \
dissociation constant, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "S"], TraditionalForm]],ExpressionUUID->
  "c7553d1f-f695-4861-a237-f1f4188c39c3"],
 "), and with a single product release step, the real invertase reaction is \
much more complicated and involves two (reversible!) product release steps. \
The system is described by the following set of equations, derived from its \
partial reactions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "d9ab2437-d3f5-48f6-b266-1b04a4173bcd"],
 ":"
}], "Text",
 CellChangeTimes->{{3.7185100238466587`*^9, 3.718510042113297*^9}, {
  3.750584388980315*^9, 3.7505845251432257`*^9}, {3.750584557512166*^9, 
  3.7505846726724863`*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"74f9547e-cb7e-44c2-a3ee-d07b9d78effe"],

