Cell[TextData[{
 "Several oxidoreducases oxidize alcohol to aldehyde, and confer the reducing \
equivalents to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["NAD", "+"], TraditionalForm]],ExpressionUUID->
  "0cb79865-1dc3-4596-84a3-ddda33cec463"],
 ". Upon binding the alcohol, the enzyme is able to accept ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["NAD", "+"], TraditionalForm]],ExpressionUUID->
  "889cad21-8a31-4a6c-a92d-7b8c3ca72ec6"],
 ", and release the products quickly without detectable trinary intermediate \
EAB. This ordered reaction scheme may be analyzed by: "
}], "Text",
 CellChangeTimes->{{3.965958735219982*^9, 3.965958742989127*^9}, {
  3.965958804342791*^9, 3.96595898653533*^9}, {3.9659590782543497`*^9, 
