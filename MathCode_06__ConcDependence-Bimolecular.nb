Cell[TextData[{
 "Figure legend: Concentration dependence of the bimolecular association \
reaction ",
 StyleBox["A + B \[Equilibrium] C",
  FontSize->24],
 " \nThe initial concentration of A is fixed at 1, the forward rate is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "12"], TraditionalForm]],ExpressionUUID->
  "fd7d21e6-c572-474d-974b-8665697ca52a"],
 "=10., the backward rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "21"], TraditionalForm]],ExpressionUUID->
  "dc59d144-72df-47a3-a83d-c6533ae8a38d"],
 "=0.1. The rates are read out from figure [X], and show a linear dependence \
as soon as the (substrate) concentration of B exceeds the (enzyme) \
concentration of A. The slope from 2\[NonBreakingSpace]mM to 10\
\[NonBreakingSpace]mm is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"139.5", " ", "-", " ", "27.8"}], "8"], TraditionalForm]],
  ExpressionUUID->"1c06dbb0-3957-4795-93a1-9aa688521ee6"],
 " = 13.96 ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["M", 
     RowBox[{"-", "1"}]], 
    SuperscriptBox["s", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "833a5896-6aa6-4998-8217-ff8b4752f236"],
 "."
}], "Text",
 CellChangeTimes->{{3.963467183322392*^9, 3.963467319605287*^9}, {
  3.96346737185378*^9, 3.963467398412643*^9}, {3.963468378880085*^9, 
  3.963468485164916*^9}, {3.963468760551702*^9, 3.9634688038332357`*^9}, {
  3.963468834441202*^9, 3.9634688539461184`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"e2546139-a364-449a-a1f6-0ced8b5092fd"],

