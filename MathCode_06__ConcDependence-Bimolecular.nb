Cell[TextData[{
 "The linear fit of our data from the 8th to the last concentration results \
in an apparent bimolecular rate constant of 9.7 \[Times] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["M", 
     RowBox[{"-", "1"}]], 
    SuperscriptBox["s", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "98e0f3d4-33ea-422d-816e-f84d219894f6"],
 ", and a zero intercept @ 0 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "6cdab11a-ca19-46a1-884f-6610fa4dc733"],
 ". "
}], "Text",
