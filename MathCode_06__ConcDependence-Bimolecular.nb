7fe378aef861"],

Cell[TextData[{
 "Given is the following system, in which one molecule flips between two \
conformations:\n  ",
 StyleBox[" A + B \[Equilibrium] C",
  FontSize->24],
 " \n",
 "This might describe a protein that binds a ligand, e.g. myoglobin and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["O", "2"], TraditionalForm]],ExpressionUUID->
  "804de9cb-149e-467b-b7f4-935b7df32d79"],
 " or similar (important: only one ligand binding site, no cooperative \
effects as in hemoglobin). Concentrations A, B and C will change with \
velocities x(t), y(t), and z(t):"
}], "Text",
 CellChangeTimes->{{3.5320872456243362`*^9, 3.532087385554812*^9}, {
  3.963286256445466*^9, 3.963286334037071*^9}, {3.9632919300252867`*^9, 
  3.9632919936168137`*^9}, {3.963454737392001*^9, 3.9634548265778503`*^9}, {
  3.963454857535634*^9, 3.963454935475727*^9}},
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"bffc6c2e-facb-4468-867f-76a031e85942"]
}, Open  ]],

