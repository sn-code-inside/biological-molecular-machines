Cell[TextData[{
 "Figure legend: Numerical simulation of the bimolecular association of A and \
B using ",
 StyleBox["NDSolve[ ]", "Code"],
 ". Initial values are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "A"], TraditionalForm]],ExpressionUUID->
  "93adfbd1-9818-4bc0-86fb-dfa2160668b0"],
 "(0) = 1., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "C"], TraditionalForm]],ExpressionUUID->
  "0eb54318-2ffd-4bdf-ad5e-d6e9b6310fba"],
 "(0) = 0, rates ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "12"], TraditionalForm]],ExpressionUUID->
  "5d6a6e60-483c-4eb0-b8e5-c7882fe1f2e0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "21"], TraditionalForm]],ExpressionUUID->
  "d78ebd34-7cbe-47f0-83f2-29377fbed0c6"],
 ", as well as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "B"], TraditionalForm]],ExpressionUUID->
  "48e80f3b-145a-4e7a-9256-bb9aaf4047aa"],
 "(0) may be varied. The lower horizontal line indicates the equilibrium \
concentration of A, the line above shows the level of half of the substrate \
turnover. "
}], "Text",
 CellChangeTimes->{{3.963467360988805*^9, 3.963467364530385*^9}, {
