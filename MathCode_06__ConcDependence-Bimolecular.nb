Cell[TextData[{
 "Python code: \n",
 StyleBox["#!/usr/local/bin/python3\nimport matplotlib.pyplot as plt\nimport \
numpy as np\nconcreihe=[0.65,0.7,0.8,0.9,1.,1.1,1.2]\n\
rates=[1/0.327,1/0.239,1/0.163,1/0.132,1/0.111,1/0.095,1/0.082]\nplt.xlabel(\
\[OpenCurlyQuote]concentration B\[CloseCurlyQuote])\nplt.ylabel(\
\[OpenCurlyQuote]rate\[CloseCurlyQuote])\n\
plt.title(\[OpenCurlyDoubleQuote]Numerical Model of Bimolecular Reaction \
06.08.2025\[CloseCurlyDoubleQuote])\nplt.legend()\nplt.plot(concreihe,rates,\
\[CloseCurlyQuote]o\[CloseCurlyQuote])\nplt.show()\n", "Code"],
