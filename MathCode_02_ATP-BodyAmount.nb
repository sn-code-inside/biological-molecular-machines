Cell["\<\
Assuming that all non-water components of our body don\[CloseCurlyQuote]t \
contain ATP/ADP, and that we consists of 2/3rd of water => we estimate a \
total between 50 and 100\[NonBreakingSpace]g ATP in our bodies.\
\>", "Text",
 CellChangeTimes->{{3.9645902167300386`*^9, 3.964590249855904*^9}, {
   3.964590354270307*^9, 3.964590355689432*^9}, {3.964590492250416*^9, 
   3.964590520084715*^9}, {3.964591207014378*^9, 3.964591264861454*^9}, {
   3.9717503621412354`*^9, 3.971750389621907*^9}, {3.971750432477809*^9, 
   3.971750486355845*^9}, 3.9847071796362143`*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"0de97054-90b6-4aab-b9d9-a431b34c98f8"],

Cell["\<\
The synthesis of ATP requires under physiological conditions approximately 50 \
kJ/mole, i.e. per molecule:\
\>", "Text",
 CellChangeTimes->{{3.9645902167300386`*^9, 3.964590249855904*^9}, {
  3.964590354270307*^9, 3.964590355689432*^9}, {3.964590492250416*^9, 
