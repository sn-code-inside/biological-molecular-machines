Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"kBT", "=", "1"}], ";", 
    RowBox[{"deltax", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        FractionBox["1", "k0"], "+", 
        FractionBox["1", 
         RowBox[{"KDATP", " ", "cATP"}]], "+", 
        FractionBox["1", 
         RowBox[{"kL0", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"beta", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "f"}], 
               FractionBox[
                RowBox[{" ", "deltaL"}], "kBT"]}]]}]}], ")"}]}]], "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"kH0", " "}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"f", 
           FractionBox[
            RowBox[{" ", "deltaH"}], "kBT"]}]]}]}]], ",", 
      RowBox[{"{", 
       RowBox[{"f", ",", 
        RowBox[{"-", 
         RowBox[{"(*", "10.", "*)"}], "rangeX"}], ",", "rangeX"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
      "PlotLabel", 
       "\[Rule]", "\"\<Consecutive steps \\r(Liu et al., 2018)\>\""}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"FontFamily", "\[Rule]", "Arial"}], ",", "Bold", ",", "fs"}],
         "]"}]}], ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"(*", "0", "*)"}], 
          RowBox[{"(*", 
           RowBox[{"-", "10."}], "*)"}], 
          RowBox[{"(*", "Automatic", "*)"}], 
          RowBox[{
           RowBox[{"-", "1"}], ",", "Automatic"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Force\>\"", ",", "\"\<velocity\>\""}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"GridLines", "->", "grid"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"color", ",", 
          RowBox[{"Thickness", "[", "thn", "]"}]}], "}"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", "is"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"is", ",", "720", ",", "\"\<Image size\>\""}], "}"}], ",", 
