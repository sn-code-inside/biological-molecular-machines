Cell[TextData[{
 StyleBox["Comment",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ": It is not trivial to see when the denominator becomes zero (i.e., where \
there is a singularity) but ",
 StyleBox["there are",
  FontVariations->{"Underline"->True}],
 " such cases because the last part of the denominator"
}], "Text",
 CellChangeTimes->{{3.7560277388432198`*^9, 3.756027848502112*^9}, 
   3.756028139192567*^9},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"fd8e668f-c686-4eb9-986d-39fd47fd7354"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Unset", "[", "kBT", "]"}], ";", 
  RowBox[{"TraditionalForm", "[", 
   RowBox[{
    RowBox[{
     FractionBox["1", "kA0"], 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       RowBox[{"f", " ", "deltaA"}], "kBT"]]}], "-", 
    RowBox[{
     FractionBox["1", "kB0"], 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       RowBox[{"f", " ", "deltaB"}], "kBT"]]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.756027868641621*^9, 3.756027910624552*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"f502406a-88d4-4439-8316-08f32f1a6b81"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      RowBox[{"deltaA", " ", "f"}], "kBT"]], "kA0"], "-", 
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      RowBox[{"deltaB", " ", "f"}], "kBT"]], "kB0"]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.75602787803505*^9, 3.7560279112397346`*^9, 
  3.781260298738049*^9, 3.853222604589085*^9},
 CellLabel->
  "Out[6]//TraditionalForm=",ExpressionUUID->"5adc8571-5c24-46f2-9d30-\
ae2baa4111bc"]
}, Open  ]],

Cell[TextData[{
 "may become <0. Consequently, it is a complicated combination of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "A0"], ",", " ", 
    SubscriptBox["k", "B0"], ",", " ", 
    RowBox[{
     RowBox[{"\\[", "Laplacian", "]"}], 
     SubscriptBox["x", "A"]}], ",", " ", 
    RowBox[{"and", " ", 
     RowBox[{
      RowBox[{"\\[", "Laplacian", "]"}], 
      SubscriptBox["x", "B"]}]}]}], TraditionalForm]],ExpressionUUID->
  "c804efa3-6871-45c6-975b-9bd71457aae0"],
 "that, in combination, may exceed the force-independent transition times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     SubscriptBox["k", "0"]], ",", " ", 
    FractionBox["1", 
     RowBox[{
      SubscriptBox["K", 
       RowBox[{"D", ",", "ATP"}]], 
      SubscriptBox["c", "ATP"]}]], ",", " ", 
    RowBox[{
     RowBox[{"\\[", "Laplacian", "]"}], 
     SubscriptBox["x", "C"]}], ","}], TraditionalForm]],ExpressionUUID->
  "07deff95-3a3a-4706-bd2b-d0cd71e8bde4"],
 " and the probability ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],ExpressionUUID->
  "1047cdf4-a4c4-4736-a0ce-3f687daa5741"],
 " to choose path A (the rest of the denominator): "
}], "Text",
 CellChangeTimes->{{3.7560277388432198`*^9, 3.7560278209652853`*^9}, {
  3.756027853437772*^9, 3.756027859526269*^9}, {3.756028181225959*^9, 
  3.756028349464663*^9}, {3.7560283847780533`*^9, 3.756028444568265*^9}, {
  3.7560285843032093`*^9, 3.7560286162855873`*^9}, {3.756028848911878*^9, 
  3.75602887527985*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"0c4ef008-c792-4650-a47c-faa166fad838"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Unset", "[", "kBT", "]"}], ";", 
  RowBox[{"TraditionalForm", "[", 
   FractionBox[
    RowBox[{
     FractionBox["1", "k0"], "+", 
     FractionBox["1", 
      RowBox[{"KDATP", " ", "cATP"}]], "+", 
     RowBox[{
      FractionBox["1", "kB0"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"f", 
        FractionBox[
         RowBox[{" ", "deltaC"}], "kBT"]}]]}]}], 
    RowBox[{"p0", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "f"}], 
       FractionBox["deltaC", "kBT"]}]]}]], "]"}]}]], "Input",
 CellChangeTimes->{{3.756028822729259*^9, 3.75602882529674*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"902373df-93a3-4eea-bb70-d53638779bc0"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      RowBox[{"deltaC", " ", "f"}], "kBT"]], " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"cATP", " ", "KDATP"}]], "+", 
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"deltaC", " ", "f"}], "kBT"]], "kB0"], "+", 
      FractionBox["1", "k0"]}], ")"}]}], "p0"], TraditionalForm]], "Output",
 CellChangeTimes->{{3.756028830180696*^9, 3.756028857561861*^9}, 
   3.781260306145823*^9, 3.853222610483818*^9},
 CellLabel->
  "Out[7]//TraditionalForm=",ExpressionUUID->"98e56d0b-dead-4948-92f2-\
13baa6d50c7f"]
}, Open  ]],

Cell["\<\
1. Liu, N., Chistol, G., Cui, Y. & Bustamante, C. Mechanochemical coupling \
and bi-phasic force-velocity dependence in the ultra-fast ring ATPase \
SpoIIIE. Elife 7, 6185 (2018).
2. Wang, M.D., Schnitzer, M.J., Yin, H., Landick, R., Gelles, J., Block, \
S.M., 1998. Force and velocity measured for single molecules of RNA \
polymerase. Science 282, 902\[Dash]907.
3. Saleh, O. A., P\[EAcute]rals, C., Barre, F. & Allemand, J. Fast, DNA\
\[Hyphen]sequence independent translocation by FtsK in a \
single\[Hyphen]molecule experiment. The EMBO Journal 23, 2430\[Dash]2439 \
(2004).\
\>", "Text",
