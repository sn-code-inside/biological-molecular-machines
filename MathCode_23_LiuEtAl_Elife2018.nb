Cell[TextData[{
 StyleBox["One",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " force-dependent step gives a single-exponential dependence, whose total \
velocity will be determined by the step size \[Delta] and the fraction of the \
total cycle time that the molecular motor is in the processs of a \
force-dependent kinetic step, ",
 StyleBox["p",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.755923973360268*^9, 3.755923981502099*^9}, {
