Cell[TextData[{
 "Since the ansatz was ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            SubscriptBox["\[Lambda]", 
             StyleBox["i", "TI"]], "(", 
            StyleBox["t", "TI"], ")"}]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["u", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "c_i(t) = e^{\\lambda _i (t)} \\cdot \\mathbf{u}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89f89600-355c-4c9f-a112-4fc386cfc937"],
 ", we can calculate the evolution of concentrations cS1(t), ... cS3(t) as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], "3", 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "c_{i}(t) = \\sum_{i=1}^3 a_i \\cdot c_i(t)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45c687e6-efeb-4872-976a-fbdefceb6104"],
 ", with amplitudes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "a_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac306f54-5033-4aea-af79-d8369d188932"],
 " that are determined by the initial concentrations.  "
}], "Text",
 CellChangeTimes->{{3.496041422824604*^9, 3.4960414352845707`*^9}, {
  3.655639932560995*^9, 3.6556399633516893`*^9}, {3.96641016080186*^9, 
  3.966410201465493*^9}, {3.966410269694792*^9, 3.966410276981843*^9}, {
  3.966410310944152*^9, 3.966410429664283*^9}, {3.966410541906783*^9, 
  3.9664105509853067`*^9}, {3.966410743986446*^9, 3.966410869077156*^9}, {
  3.9664111178726797`*^9, 3.966411168629682*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"35bb8c7f-2cea-4954-ab1f-3d97a719a341"]
}, Open  ]],

