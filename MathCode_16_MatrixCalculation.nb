Cell[TextData[{
 "The Eigenvalue calculus solves the equation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", FontSlant -> "Bold"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["u", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Lambda]", 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["u", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{A} \\cdot \\mathbf{u}_i\n= \\lambda _i \\cdot  \\mathbf{u}_i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69a24fa0-498b-428a-a6c9-c210a75f463e"],
 " . \nThat means we can multiply the first Eigenvalue of A with the first \
value of the Eigenvector... "
}], "Text",
 CellChangeTimes->{{3.496041422824604*^9, 3.4960414352845707`*^9}, {
  3.655639932560995*^9, 3.6556399633516893`*^9}, {3.96641016080186*^9, 
  3.966410201465493*^9}, {3.966410269694792*^9, 3.966410276981843*^9}, {
  3.966410310944152*^9, 3.9664104104311657`*^9}, {3.966410535607761*^9, 
  3.966410537824492*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"79839b08-4090-497e-b022-4f786bfcea27"],

