Cell[TextData[{
 "Generate data that is superimposed by noise that follows a Gaussian \
distribution (",
 StyleBox["NormalDistribution[mean,width]", "Code"],
 "): "
}], "Text",
 CellChangeTimes->{{3.973740893561185*^9, 3.9737408975393333`*^9}, {
  3.973743044196166*^9, 3.973743110053833*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"8208898e-d06a-4048-b370-3f4ee8b89919"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hmp", "=", 
  RowBox[{"HiddenMarkovProcess", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0.5", ",", "0.3", ",", "0.2"}], "}"}], ",", "tm3state", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"1.", ",", "0.15"}], "]"}], ",", 
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"2.", ",", "0.35"}], "]"}], ",", 
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"3.", ",", "0.25"}], "]"}]}], "}"}]}], 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ExponentialDistribution", "[", "1", "]"}], ",", 
      RowBox[{"ExponentialDistribution", "[", "1.5", "]"}], ",", 
      RowBox[{"ExponentialDistribution", "[", "3", "]"}]}], "}"}], "*)"}], 
