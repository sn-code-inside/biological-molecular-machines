Cell[TextData[{
 "We defined for our example: k12 = 5 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "5c010812-ef26-4135-8498-e196cf561bef"],
 ", k21 = 0.5 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "28586943-9d8e-4131-8066-f0197c2be573"],
 ", k23 = 1. ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "8766bdf4-dcb9-4684-8225-7b1f90e50b01"],
 ", k32 = 0.1 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "48fdb152-5b73-40ce-9010-e9d2af31583e"],
 ". k13 and k31 were 0. The fastest rate is 5\[NonBreakingSpace]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "4213f8eb-ffdf-410a-ab91-f6a828edfff9"],
 " \[LongLeftRightArrow] 0.2\[NonBreakingSpace]s transition time, hence the \
sampling frequency should be at least 10\[NonBreakingSpace]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "fedf5c20-508e-40b6-9908-4228c298deaa"],
 " = 10\[NonBreakingSpace]Hz.  "
}], "Text",
