      RowBox[{"ftsize", ",", "18", ",", "\"\<font size\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "12", ",", "14", ",", "18", ",", "21", ",", "24", ",", "28", ",", 
       "36"}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"thn", ",", "0.004", ",", "\"\<line thickness\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "0.0025", ",", "0.004", ",", "0.0067", ",", "0.0075", ",", "0.01"}], 
      "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
