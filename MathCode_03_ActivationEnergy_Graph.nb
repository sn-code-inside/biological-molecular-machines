     RowBox[{"{", 
      RowBox[{
      "450", ",", "650", ",", "720", ",", "900", ",", "1050", ",", "1280", ",",
        "1920"}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Eactivation", ",", "1", 
       ",", "\"\<\!\(\*SubscriptBox[\(E\), \(a\)]\)\>\""}], "}"}], ",", ".0", 
     ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dx", ",", "1", ",", "\"\<distance \[Delta]\>\""}], "}"}], ",", 
     "0.5", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
