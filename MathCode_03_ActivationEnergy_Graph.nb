Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ExponentialE]", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "deltaG"}], " ", "x"}], ")"}]}], "+", 
      RowBox[{"Eactivation", " ", 
       RowBox[{"\[ExponentialE]", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "width"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "dx"}], ")"}], "^", "2"}]}], ")"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "2.5"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0"}], ",", "Automatic"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "yRange"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"GridLines", "\[Rule]", "grid"}], ",", "\[IndentingNewLine]", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<reaction coordinate\>\"", ",", 
          RowBox[{"FontSize", "->", "ftsize"}]}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\:2206G\>\"", ",", 
          RowBox[{"FontSize", "->", "ftsize"}]}], "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
