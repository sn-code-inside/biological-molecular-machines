c886806ee7ac"],

Cell[TextData[{
 "The graph shows the smooth energy landscape of a reaction that proceeds via \
an activation energy barrier in a characteristic distance \[Delta]. The \
reaction is driven by a free enthalpy of ",
 Cell[BoxData[
  SubscriptBox["\:2206G", 
   RowBox[{
    RowBox[{"rct", "'"}], "n"}]]],
  CellChangeTimes->{{3.68957130388973*^9, 3.689571695832718*^9}, {
    3.689571730836892*^9, 3.6895717577117777`*^9}, 3.689571864962276*^9, {
    3.689572156366914*^9, 3.689572191808923*^9}, {3.968219788578032*^9, 
    3.968219794877046*^9}, 3.968219828692739*^9, {3.968219929560873*^9, 
    3.968220089247827*^9}, {3.968220134869095*^9, 3.9682201691419287`*^9}, {
    3.9682203090506783`*^9, 3.96822031315213*^9}, {3.9720184956155577`*^9, 
    3.9720184992769327`*^9}, {3.972018768799502*^9, 3.972018816048214*^9}, {
    3.9779671424205627`*^9, 3.977967149378894*^9}, {3.9779671905385027`*^9, 
    3.9779672033093653`*^9}, {3.977967246237534*^9, 3.97796735053841*^9}, {
    3.9779674140466843`*^9, 3.977967440557892*^9}},ExpressionUUID->
  "91032fb4-d6da-428c-853e-9f7d4e568488"],
 " , the activation enthalpy is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "a"], TraditionalForm]],ExpressionUUID->
  "107b408e-09c0-49f8-b698-c17b49451ed1"],
 ". External loads will shift the characteristic distance \[Delta], and/or \
the width of the potential barrier. \nThe smooth potential surface is \
described by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["G", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"\[CapitalDelta]", 
            SubscriptBox[
             StyleBox["G", "TI"], 
             RowBox[{
               StyleBox["r", "TI"], 
               StyleBox["c", "TI"], 
               SuperscriptBox[
                StyleBox["t", "TI"], "\[Prime]"], 
               StyleBox["n", "TI"]}]], "\[CenterDot]", 
            StyleBox["x", "TI"]}]], "+", 
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["a", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            StyleBox["w", "TI"], 
            StyleBox["i", "TI"], 
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"], 
            StyleBox["h", "TI"], "\[CenterDot]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], "-", "\[Delta]"}], ")"}], "2"]}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta{G} = e^{\\Delta{G_{rct'n}} \\cdot x} \n + E_a \\cdot e^{-width \
\\cdot (x - \\delta)^2 }", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd1e135c-5717-49c1-9137-60b2e155c4bd"],
 ". "
}], "Text",
 CellChangeTimes->{{3.5320872456243362`*^9, 3.532087385554812*^9}, {
  3.963286256445466*^9, 3.963286334037071*^9}, {3.9632919300252867`*^9, 
  3.9632919936168137`*^9}, {3.963454737392001*^9, 3.9634548265778503`*^9}, {
  3.963454857535634*^9, 3.963454935475727*^9}, {3.9635482122465353`*^9, 
  3.963548358922091*^9}, {3.9779674570887127`*^9, 3.977967656097727*^9}, {
  3.977967689161593*^9, 3.977967776266357*^9}, {3.977967874107953*^9, 
  3.977967901095296*^9}, {3.977968298188957*^9, 3.977968298478055*^9}},
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"8aecacbd-0e9b-4986-a23e-ea52633303b5"],

