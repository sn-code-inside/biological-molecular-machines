      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "ftsize"}], "]"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"color", ",", 
         RowBox[{"Thickness", "[", "thn", "]"}]}], "}"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "\[Rule]", "is"}]}], "\[IndentingNewLine]", "]"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"color", ",", 
