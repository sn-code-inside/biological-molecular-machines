Cell[TextData[{
 "We define for our example: k12 = 5 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "5c010812-ef26-4135-8498-e196cf561bef"],
 ", k21 = 0.5 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "28586943-9d8e-4131-8066-f0197c2be573"],
