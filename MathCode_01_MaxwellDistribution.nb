Cell[TextData[{
 "We plot the velocity distribution. Comments to the code: The function ",
 StyleBox["MaxwellDistribution[\[Sigma]v]", "Input"],
 " is defined such that the energy is scaled in relation to ",
 StyleBox["\[Sigma]v", "Input"],
 ", and equals ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    FractionBox[
     RowBox[{"2", " ", 
      SubscriptBox["k", "B"], "T"}], "m"]], TraditionalForm]],ExpressionUUID->
  "11e97a43-c91b-47b3-9076-56bdea1e3320"],
 ". This parameter defines the distribution \[ScriptCapitalD]. Note that the \
maximum of the distribution is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          RowBox[{
            StyleBox["W", "TI"], ",", 
            StyleBox["m", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["x", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          FractionBox[
           RowBox[{"2", 
             SubscriptBox[
              StyleBox["k", "TI"], 
              StyleBox["B", "TI"]], 
             StyleBox["T", "TI"]}], 
           StyleBox["m", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "v_{W,max}=\\sqrt{\\frac{2k_B T}{m}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8bf1f12b-88f9-4416-82eb-d804e9e5d4d9"],
 " (the ",
 StyleBox["most likely",
  FontWeight->"Bold"],
 " velocity), whereas the ",
 StyleBox["mean",
  FontWeight->"Bold"],
 " velocity (where half of the particles are slower, half are faster) is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["e", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["n", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          FractionBox[
           RowBox[{"8", 
             SubscriptBox[
              StyleBox["k", "TI"], 
              StyleBox["B", "TI"]], 
             StyleBox["T", "TI"]}], 
           RowBox[{"\[Pi]", 
             StyleBox["m", "TI"]}]]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "v_{mean}=\\sqrt{\\frac{8 k_B T}{\\pi m}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8859fa7-572a-4537-ad97-17dc53b62a04"],
 ".\nThe function ",
 StyleBox["PDF[\[NonBreakingSpace]]", "Input"],
 " stands for \[OpenCurlyDoubleQuote]point density function\
\[CloseCurlyDoubleQuote], i.e. the frequency of events that the velocity on \
the x\[NonBreakingSpace]axis. Other elements of the code are used for styling \
and formatting."
}], "Text",
 CellChangeTimes->{{3.768117634142901*^9, 3.768117652566938*^9}, {
  3.768117684744864*^9, 3.768117713329013*^9}, {3.848120734170041*^9, 
