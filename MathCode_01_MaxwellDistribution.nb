Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]v", "=", 
     RowBox[{
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", "=", 
           RowBox[{"Quantity", "[", "\"\<BoltzmannConstant\>\"", "]"}]}], ",", 
          RowBox[{"t", "=", 
           RowBox[{"Quantity", "[", 
            RowBox[{"T", ",", "\"\<Kelvins\>\""}], "]"}]}]}], "}"}], ",", 
        SqrtBox[
         RowBox[{"k", " ", 
          RowBox[{"t", "/", "m"}]}]]}], "]"}], "//", "UnitConvert"}]}], ";", 
    RowBox[{"\[ScriptCapitalD]", "=", 
     RowBox[{"MaxwellDistribution", "[", 
      FormBox["\[Sigma]v",
       TraditionalForm], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{"\[ScriptCapitalD]", ",", 
         RowBox[{"Quantity", "[", 
          RowBox[{"v", ",", 
           RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], 
        "]"}], "//", "Evaluate"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "0", ",", "6500"}], "}"}], ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Full", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "Full"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Filling", "\[Rule]", "filling"}], ",", 
      RowBox[{"AxesLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<m/s\>\"", ",", "\"\<densisty function\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Velocity distribution\>\""}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"color", ",", 
         RowBox[{"Thickness", "[", "thn", "]"}]}], "}"}]}], ",", 
      RowBox[{"LabelStyle", "\[Rule]", "fs"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", "is"}], ",", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"QuantityMagnitude", "[", 
             RowBox[{"UnitConvert", "[", 
              RowBox[{"Mean", "[", "\[ScriptCapitalD]", "]"}], "]"}], "]"}], ",",
             "0"}], "}"}], "]"}], ",", 
         RowBox[{"Inset", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"StringJoin", "[", 
              RowBox[{"\"\<Temperature \>\"", ",", 
               RowBox[{"ToString", "[", "T", "]"}], ",", "\"\< K = \>\"", ",", 
               RowBox[{"ToString", "[", 
                RowBox[{"T", "-", "273."}], "]"}], ",", "\"\< \[Degree]C\>\"",
                ",", "\"\<\\rMean velocity \>\"", ",", 
               RowBox[{"ToString", "[", 
                RowBox[{
                 RowBox[{"Mean", "[", "\[ScriptCapitalD]", "]"}], "//", 
                 "UnitConvert"}], "]"}]}], "]"}], ",", "fs", ",", 
             RowBox[{"TextAlignment", "\[Rule]", "Left"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"5000", ",", "Center"}], "}"}]}], "]"}]}], "}"}]}]}], 
     "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"color", ",", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.5", ",", "0.5", ",", "0.85"}], "]"}], ",", "Black", ",", 
       RowBox[{"Darker", "[", "Gray", "]"}], ",", "Orange", ",", "Red", ",", 
       RowBox[{"Darker", "[", "Green", "]"}]}], "}"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"filling", ",", "Axis"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"None", ",", "Axis"}], "}"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fs", ",", "21", ",", "\"\<Font size\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"14", ",", "18", ",", "21", ",", "24", ",", "28"}], "}"}]}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
