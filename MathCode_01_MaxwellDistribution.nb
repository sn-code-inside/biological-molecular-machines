Cell[CellGroupData[{

Cell["Simple calculator", "Subsection",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.984710475879668*^9},
 CellTags->
  "calculator",ExpressionUUID->"d5afc14d-e374-486f-82b0-599ee34e7c16"],

Cell[TextData[{
 "Together with the theory of ideal gases, we can estimate the ",
 StyleBox["volume",
  FontWeight->"Bold"],
 " of a certain amount of gas (in moles) at given temperature and pressure. \
We can further calculate \[LeftAngleBracket]\[CapitalDelta]s\
\[RightAngleBracket], the ",
 StyleBox["mean distance of gas atoms",
  FontWeight->"Bold"],
 " (or molecules; ",
 Cell[BoxData[
  RadicalBox[
   FractionBox[
    RowBox[{
     SubscriptBox["n", "A"], " ", "N"}], "V"], "3"]],
  CellChangeTimes->{{3.9834303566732817`*^9, 3.9834303749965897`*^9}, {
    3.983430496338282*^9, 3.9834308942382317`*^9}, {3.9834309839544992`*^9, 
    3.983431036877061*^9}, {3.983431139379609*^9, 3.9834312796142063`*^9}, {
    3.983431321612207*^9, 3.9834313234905863`*^9}, {3.983431368701641*^9, 
    3.983431393971246*^9}, {3.983431431226968*^9, 3.983431458030445*^9}, {
    3.983431529029942*^9, 3.983431592625347*^9}, {3.9834316860031977`*^9, 
    3.983431818458605*^9}, {3.9834319066763077`*^9, 3.983431912690735*^9}, {
    3.983432057900951*^9, 3.983432167627204*^9}, {3.98343220515867*^9, 
    3.983432251018091*^9}, {3.9834324679838057`*^9, 3.98343246928296*^9}, {
    3.98343250294631*^9, 3.983432595385111*^9}, {3.983432644727695*^9, 
    3.983432673417198*^9}, {3.9834327316551857`*^9, 3.9834327622063427`*^9}, {
    3.983432857358471*^9, 3.9834329542017736`*^9}, {3.983432989547483*^9, 
    3.983433102285261*^9}, {3.983433147410276*^9, 3.983433258698534*^9}, {
    3.98343334836132*^9, 3.983433457065433*^9}, {3.983433503236779*^9, 
    3.98343357587844*^9}, {3.983433675878785*^9, 3.9834337157386847`*^9}, {
    3.983434042744545*^9, 3.9834341046021976`*^9}, {3.9834341658869667`*^9, 
    3.9834341672935257`*^9}, {3.983434226412818*^9, 3.983434245936204*^9}, {
    3.9834342828105173`*^9, 3.983434287414501*^9}, {3.983434379767614*^9, 
    3.983434397520932*^9}, {3.983434435882019*^9, 3.983434448471921*^9}, 
    3.9834347450364847`*^9, {3.983434776548164*^9, 3.9834347786617117`*^9}, 
    3.983434891317466*^9, {3.9834349278503428`*^9, 3.983434940603528*^9}, {
    3.983434977760289*^9, 3.983435002337035*^9}, {3.983435041297367*^9, 
    3.983435041704187*^9}, {3.9834350767857313`*^9, 3.9834350858361673`*^9}, {
    3.983435189833726*^9, 3.983435209456102*^9}, {3.9834352532569113`*^9, 
    3.983435254437488*^9}, {3.983496632135742*^9, 3.983496674268303*^9}},
  ExpressionUUID->"358d9bf8-3b1e-4397-895f-9101df32c4fd"],
 "), and the ",
 StyleBox["kinetic energy",
  FontWeight->"Bold"],
 " of the atoms/molecules ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox["3", "2"], " ", 
     SubscriptBox["k", "B"]}]}], TraditionalForm]],ExpressionUUID->
  "334e033b-7edb-4179-b3e5-d355e32d11c0"],
 "T for three degrees of freedom).\nThe ",
 StyleBox["collision frequency",
  FontWeight->"Bold"],
 " may be calculated from mean velocity and mean distance ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{"\[LeftAngleBracket]", "v", "\[RightAngleBracket]"}], 
     RowBox[{
     "\[LeftAngleBracket]", "\[CapitalDelta]s", "\[RightAngleBracket]"}]]}], 
   TraditionalForm]],ExpressionUUID->"68f1a913-4805-418f-b40a-9aa8f469fc2b"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[CapitalDelta]t"], TraditionalForm]],ExpressionUUID->
  "f337201a-b262-4d17-953d-dba4e27de870"],
 "). \nOne may intuitively suspect that two particles that fly towards each \
other encounter at ",
 StyleBox["half",
  FontWeight->"Bold"],
 " the mean distance. However, the flight direction with respect to the \
connecting line between their positions is random. Both particles may move in \
the same direction (albeit with different velocities) such that the actual \
travelling distance \[CapitalDelta]d until the encounter will be much larger \
than the mean \[LeftAngleBracket]\[CapitalDelta]s\[RightAngleBracket]. The \
directional component towards each other will be compensated by the component \
away from each other."
}], "Text",
 CellChangeTimes->{{3.768117634142901*^9, 3.768117652566938*^9}, {
   3.768117684744864*^9, 3.768117713329013*^9}, {3.848120734170041*^9, 
   3.848120765693286*^9}, {3.851485857366276*^9, 3.851485913456195*^9}, {
   3.851760507383925*^9, 3.851760554837002*^9}, {3.851760675549889*^9, 
   3.8517607257712793`*^9}, {3.8517609350016937`*^9, 3.851761176544628*^9}, {
   3.970559648380055*^9, 3.9705599662238817`*^9}, {3.9834345198236647`*^9, 
   3.983434555223154*^9}, {3.983506348123685*^9, 3.983506448695959*^9}, {
   3.983506500312868*^9, 3.9835065189646378`*^9}, {3.9835069169747133`*^9, 
   3.983506986446821*^9}, 3.983507019357951*^9, {3.9835071622656193`*^9, 
   3.983507370257197*^9}, {3.983507407842143*^9, 3.983507645450122*^9}, {
   3.983507679442946*^9, 3.983507718371686*^9}, {3.983507805086516*^9, 
   3.983507821164134*^9}, {3.9835081164735947`*^9, 3.983508165849084*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"36927994-58b7-458e-9f1b-8c33d17a2d76"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
