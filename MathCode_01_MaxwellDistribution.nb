 RowBox[{"CellPrint", "[", 
  RowBox[{"TextCell", "[", 
   RowBox[{"\"\<Simple calculator\>\"", ",", 
    RowBox[{"CellTags", "\[Rule]", "\"\<calculator\>\""}], 
    ",", "\"\<Subsection\>\""}], "]"}], "]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.98470972977287*^9, 3.9847097389730597`*^9}, {
  3.984709993546811*^9, 3.9847100396364326`*^9}, {3.984710142466959*^9, 
  3.984710198980298*^9}, {3.98471023812495*^9, 3.984710324100412*^9}, {
  3.9847104599260073`*^9, 3.984710473499852*^9}},
