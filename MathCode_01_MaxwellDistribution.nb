Cell[CellGroupData[{

Cell["2. Molar volume, mean particle distance, and internal energy", "Section",
 CellChangeTimes->{{3.772875577373657*^9, 3.772875596734243*^9}, {
  3.8481176608665943`*^9, 3.8481176661686163`*^9}, {3.8514857238061333`*^9, 
  3.851485783396737*^9}, {3.8517603686349697`*^9, 3.8517604126781197`*^9}, {
  3.970560045211849*^9, 3.9705600746982727`*^9}, {3.970627994086536*^9, 
  3.970628007047735*^9}, {3.983434618345196*^9, 3.983434667062417*^9}, {
  3.983506334701309*^9, 
