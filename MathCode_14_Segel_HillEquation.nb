Cell[CellGroupData[{

Cell["Non-cooperative sites: considerations on binding affinities", \
"Subsection",
 CellChangeTimes->{{3.719655073500022*^9, 3.7196550778022013`*^9}, 
   3.7196559388468847`*^9, 3.7197298110167427`*^9, {3.719735252320448*^9, 
   3.719735294976581*^9}},ExpressionUUID->"02ffba92-1d01-4adb-8dbb-\
801f03425f01"],

Cell[TextData[{
 "We have naively used the association constants, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"S", ",", "i"}]], TraditionalForm]],ExpressionUUID->
  "ce4bc5e3-6f31-4390-bd66-28e69e497a76"],
 ", for each binding step. There is one important point that has to be \
elaborated further."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJwdzU0og3EAx/HlhrDlbYmDYou0UJzG9iSWobQDmrdibNRsrYhpCeWANkxS
