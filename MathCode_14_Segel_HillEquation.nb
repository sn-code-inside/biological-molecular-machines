Cell[TextData[{
 "Figure 3: Substrate binding and dissociation to an enzyme with four binding \
pockets. Possible binding and dissociation paths from state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "\[CenterDot]", 
    SubscriptBox["S", "2"]}], TraditionalForm]],ExpressionUUID->
  "39ccda4f-b99d-4c4d-85d1-2f5c51d83516"],
