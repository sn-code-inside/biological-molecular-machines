NkmvrwDRCoyujSD6zMH7YDpigqT9tW2vHSepBsWAaABpTKMM
  "],
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"b4fa3a54-362c-4d22-afb2-0ecb44fee8a5"],

Cell[TextData[{
 StyleBox["Exercise",
  FontWeight->"Bold"],
 ": Change the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"S", ",", "i"}]], TraditionalForm]],ExpressionUUID->
  "7b4e3e12-c10c-47f4-8dbd-b273b4bb8b96"],
 " values individually, and check whether they can be approximated with the \
Hill model by varying the Hill coefficient and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "S"], TraditionalForm]],ExpressionUUID->
  "1e26d4c4-35ca-4e8a-87f3-7a83148a5577"],
 "\[CloseCurlyQuote] !"
}], "Text",
