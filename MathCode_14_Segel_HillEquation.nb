Cell[TextData[{
 "To see the point, we go back to the finding that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"S", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "c87032b4-b177-472c-b3c8-d58d8fae4086"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SubscriptBox["k", "21"], 
     SubscriptBox["k", "12"]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"or", " ", 
        SubscriptBox["K", 
         RowBox[{"S", ",", "2"}]]}], "=", 
       FractionBox[
        SubscriptBox["k", "32"], "k23"]}], ",", " ", 
      RowBox[{"etc", "."}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "4d27a439-7225-43ca-81d2-eae8494a30f2"],
 ", and figure out how many ways there are to fill the first (second, third, \
etc.) binding site of the oligomeric enzyme: ",
 Cell[BoxData[
  GraphicsBox[
   TagBox[RasterBox[CompressedData["
