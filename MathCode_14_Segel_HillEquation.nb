Cell[TextData[{
 "Figure 1: Kinetic scheme for enzymes (usually enzyme oligomers) that bind \
multiple substrate molecules to ",
 StyleBox["n",
  FontSlant->"Italic"],
 " binding sites. "
}], "Text",
 CellChangeTimes->{{3.694872740308818*^9, 3.6948727448521557`*^9}, {
