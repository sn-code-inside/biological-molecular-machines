Cell[CellGroupData[{

Cell["Allosteric Coupling of Substrate Binding Affinities", "Section",
 CellChangeTimes->{{3.530447681984796*^9, 
  3.530447702335655*^9}},ExpressionUUID->"77eb00f2-b870-407a-b214-\
f449877f5071"],

Cell[TextData[{
 "At second thought, it is not surprising that completely independent binding \
sites in a protein oligomer behave as if they were present in ",
 StyleBox["n",
  FontSlant->"Italic"],
 " independent enzymes. However, if the catalytic constants of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "-th occupied binding site, and the affinity is influenced by the occupance \
of the other sites, things change (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "i"], TraditionalForm]],ExpressionUUID->
  "9690f5a9-6493-4d4d-b0f1-050f6ff29734"],
 " is a factor that accounts for the change of affinity, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", 
    RowBox[{"p", ",", "i"}]], TraditionalForm]],ExpressionUUID->
  "415b14ca-715b-4d32-9e5d-57d2b3ea07e8"],
 "the turnover of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "-th occupied site): "
}], "Text",
 CellChangeTimes->{{3.52939199545092*^9, 3.529392030385601*^9}, {
  3.529909363754841*^9, 3.529909401998101*^9}, {3.529992957650943*^9, 
  3.529993012770917*^9}, {3.529995036438624*^9, 3.5299950664333878`*^9}, {
  3.530009341564414*^9, 3.53000938247946*^9}, {3.530016128543475*^9, 
  3.530016142004745*^9}, {3.530016318505622*^9, 3.530016321193174*^9}, {
  3.530016431958441*^9, 3.5300164767746677`*^9}, {3.5300165646310167`*^9, 
  3.530016600373643*^9}, {3.530016945463355*^9, 3.5300169932939453`*^9}, {
  3.530358941034513*^9, 3.5303589586152267`*^9}, {3.530422153097567*^9, 
  3.5304224078622427`*^9}, {3.719736932428187*^9, 3.719737091216056*^9}},
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"fdc2af12-0934-4ca8-bbca-a1ec7230d39e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["k", 
         RowBox[{"p", ",", "i"}]], 
        RowBox[{"Binomial", "[", 
         RowBox[{"#2", ",", "i"}], "]"}], " ", "i", " ", 
        RowBox[{
         RowBox[{"cS", "^", "i"}], " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{"#2", " ", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               SubscriptBox["a", 
                RowBox[{"(", "j", ")"}]], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"i", "-", "j"}], ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "i"}], "}"}]}], "]"}], 
           RowBox[{"Power", "[", 
            RowBox[{"#1", " ", ",", " ", "i"}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "#2"}], "}"}]}], "]"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Binomial", "[", 
           RowBox[{"#2", ",", "i"}], "]"}], " ", 
          RowBox[{"cS", "^", "i"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              SubscriptBox["a", 
               RowBox[{"(", "j", ")"}]], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"i", "-", "j"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "i"}], "}"}]}], "]"}], " ", 
          RowBox[{"Power", "[", 
           RowBox[{"#1", " ", ",", " ", "i"}], "]"}]}], ")"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "#2"}], "}"}]}], " ", "]"}], " ", ")"}]}],
    " ", "&"}], "[", 
  RowBox[{
   SubscriptBox["K", "S"], ",", "4"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"#", "subunits"}], " ", "*)"}], "]"}]], "Input",
 CellChangeTimes->{{3.529932738638111*^9, 3.5299327519892807`*^9}, {
