Cell["\<\
Figure 2: Substrate binding and dissociation to an enzyme with four binding \
pockets. The first binding event can occur to either of the four sites. The \
initial state (no bound substrate molecules) can only be reached by one path, \
namely dissociation of that single bound ligand.  \
\>", "Text",
 CellChangeTimes->{{3.694872740308818*^9, 3.6948727448521557`*^9}, {
  3.6957093723811617`*^9, 3.695709374212212*^9}, {3.719734374662339*^9, 
  3.719734376021804*^9}, {3.719734461352054*^9, 3.719734688824994*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"01f04b0b-be8d-4c46-a840-8b4cc8a09157"],

Cell[TextData[{
 "From the figure, we see that there are ",
 StyleBox["four",
  FontWeight->"Bold"],
 " ways of occupying ",
 StyleBox["one",
  FontWeight->"Bold"],
 " substrate binding site, and for each of the occupancy states, there is \
exactly one option to go back to the substrate-free state (namely loosing \
that same ligand). Hence, the ",
 StyleBox["effective",
  FontSlant->"Italic"],
 " association constant (for the entire tetramer) is: "
}], "Text",
 CellChangeTimes->{{3.719652881573123*^9, 3.719652892045514*^9}, {
  3.719727088125182*^9, 3.7197271778050423`*^9}, {3.71972721852689*^9, 
  3.71972736338118*^9}, {3.719727633169477*^9, 3.719727734500592*^9}, {
  3.719729847203767*^9, 3.7197298514680433`*^9}, {3.7197300201086063`*^9, 
  3.7197300334993687`*^9}, {3.719730096109654*^9, 3.719730104694813*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"fcc7a42e-7c52-4a60-a6d4-c154d9b8c348"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["K", 
    RowBox[{"S", ",", "1"}]], "=", 
   FractionBox[
    RowBox[{"1", " ", 
     SubscriptBox["k", "21"]}], 
    RowBox[{"4", " ", 
     SubscriptBox["k", "12"]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.719727738484354*^9, 3.719727775542226*^9}, {
   3.719727946319571*^9, 3.719727948557269*^9}, 3.719728048058654*^9, {
   3.719729915959461*^9, 3.71972992056662*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"ffbccaa6-3e85-4403-a9b3-4288010e21f3"],

Cell[TextData[{
 "The ",
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 " (or ",
 StyleBox["microscopic",
  FontSlant->"Italic"],
 ") association constant, which is due to the biochemical properties of the \
single binding pockets, is"
}], "Text",
 CellChangeTimes->{{3.719652881573123*^9, 3.719652892045514*^9}, {
  3.719727088125182*^9, 3.7197271778050423`*^9}, {3.71972721852689*^9, 
  3.71972736338118*^9}, {3.719727633169477*^9, 3.719727734500592*^9}, {
  3.719728070155835*^9, 3.719728125844756*^9}, {3.7197300681321573`*^9, 
  3.719730080605098*^9}, {3.7197301171586018`*^9, 3.719730129503111*^9}, {
  3.972449908213619*^9, 3.972449912813519*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"b8c74e6b-b259-4015-be81-d54fd618d194"],

