Cell["\<\
The description (5) is attributed to Gilbert S. Adair and Linus Pauling. \
\>", "Text",
 CellChangeTimes->{{3.719737415716011*^9, 3.7197374484291553`*^9}, {
  3.7197376206909313`*^9, 3.719737631492691*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"824e183b-37a8-4f3e-9c97-24bd3ed9e42f"],

Cell[TextData[{
 "In theory, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "i"], TraditionalForm]],ExpressionUUID->
  "915e1deb-bc96-462f-a63b-d2368d6b1429"],
 " could be adjusted freely, such that equation generally differs from the \
Henri-Michaelis-Menten equation. However, if the catalytic constants are not \
affected by the occupance, the equation resembles the Hill equation very \
closely. Let us therefore look at the magnitude of the influences. "
}], "Text",
 CellChangeTimes->{{3.52939199545092*^9, 3.529392030385601*^9}, {
   3.529909363754841*^9, 3.529909401998101*^9}, {3.529992957650943*^9, 
   3.529993012770917*^9}, {3.529995036438624*^9, 3.5299950664333878`*^9}, {
   3.530009341564414*^9, 3.53000938247946*^9}, {3.530016128543475*^9, 
   3.530016142004745*^9}, {3.530016318505622*^9, 3.530016321193174*^9}, {
   3.530016431958441*^9, 3.5300164767746677`*^9}, {3.5300165646310167`*^9, 
   3.530016600373643*^9}, {3.530016945463355*^9, 3.5300169932939453`*^9}, {
   3.5303587592723303`*^9, 3.5303588434759817`*^9}, {3.5304224440801277`*^9, 
   3.530422445037847*^9}, {3.5304225791008587`*^9, 3.530422628607389*^9}, {
   3.530424358096949*^9, 3.5304243998824778`*^9}, {3.5304250911261578`*^9, 
   3.530425094223654*^9}, {3.5304282459929047`*^9, 3.530428381478211*^9}, {
   3.5304298539786367`*^9, 3.530429928738367*^9}, 3.5304481402297707`*^9, {
   3.719737165780138*^9, 3.719737260502182*^9}, {3.7197373778254833`*^9, 
   3.719737378275888*^9}, 3.7197374083161783`*^9},
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"b6236d01-d2b7-4243-a3eb-1ecbdc9a49b0"]
