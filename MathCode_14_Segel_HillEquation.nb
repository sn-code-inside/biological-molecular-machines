              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "#"}], "}"}]}], "]"}], " ", 
            RowBox[{
             SubscriptBox["K", "S"], "^", "#"}]}], ")"}]}], ")"}]}], ")"}]}], 
     "&"}], "[", "4", "]"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"number", " ", "of", " ", "interacting", " ", "subunits"}], " ", 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.530428400068417*^9, 3.530428478050263*^9}, {
