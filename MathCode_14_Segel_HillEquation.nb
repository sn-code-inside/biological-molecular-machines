Cell[CellGroupData[{

Cell["Non-cooperative sites: reaction velocity", "Subsection",
 CellChangeTimes->{{3.719655073500022*^9, 3.7196550778022013`*^9}, 
   3.7196559388468847`*^9, 3.7197298110167427`*^9, {3.719735303825165*^9, 
