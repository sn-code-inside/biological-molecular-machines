Cell[BoxData[
 RowBox[{
  RowBox[{"Unset", "[", "n", "]"}], ";", 
  RowBox[{"v", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["k", "cat"], 
        RowBox[{
         RowBox[{"cS", "^", "n"}], " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               SubscriptBox["a", 
                RowBox[{"(", "j", ")"}]], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"#", "-", "j"}], ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "#"}], "}"}]}], "]"}], " ", 
           RowBox[{
            SubscriptBox["K", "S"], "^", "#"}]}], ")"}]}]}], ")"}], "/", " ", 
      
      RowBox[{"(", 
       RowBox[{"1", "+", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cS", "^", "n"}], " ", "/", 
          RowBox[{"(", 
