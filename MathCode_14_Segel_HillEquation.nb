 Background->GrayLevel[
  0.85],ExpressionUUID->"434236c7-e6b9-4ec0-9cb1-7ed014079ce8"],

Cell[TextData[{
 "The overall reaction velocity is the sum of all production rates of all \
occupied binding site ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["k", 
     RowBox[{"P", ",", "i"}]]}], TraditionalForm]],ExpressionUUID->
  "1a51fdc5-f954-47c4-a4ad-1a62676cbd6c"],
 "). ",
