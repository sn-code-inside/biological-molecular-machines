812499e60cdd"],

Cell[TextData[{
 "In result (1), we derived the velocity equation in terms of affinities in \
each binding step ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["K", 
     RowBox[{"S", ",", "i"}]]}], TraditionalForm]],ExpressionUUID->
  "b1c65802-c745-4c98-ad95-5779566a1e81"],
 "). With result (2), we can substitute the effective affinities, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"S", ",", "i"}]], TraditionalForm]],ExpressionUUID->
  "b41f160a-985d-4324-8424-bb39ae1d8ce9"],
 ", with the intrinsic affinity:"
