Cell[CellGroupData[{

Cell["Graphical Representation", "Section",
 CellChangeTimes->{{3.5304478619654503`*^9, 
  3.5304478676436253`*^9}},ExpressionUUID->"4c376de1-7931-4ba0-9263-\
ec264d33a4a5"],

Cell[TextData[{
 "The following dynamic plot investigates the validity of Hill\
\[CloseCurlyQuote]s approximation for a tetrameric enzyme. Hill\
\[CloseCurlyQuote]s model gathers all individual allosteric modifications, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]],ExpressionUUID->
  "b4489521-a610-46f8-90f8-8b5868a44e28"],
 "in a single factor, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"S", "'"}]], TraditionalForm]],ExpressionUUID->
  "a48251a4-5104-45ef-a693-e807a3a5c9d7"],
 " (",
 StyleBox["KsPrime",
  FontSlant->"Italic"],
 "), whereas the full Adair-Pauling model allows the adjustment of all for \
binding affinities."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBmIQ/SE37/1x71eON8LOfAbRK9Qr+o74vHIs+mA/GUS3
