Cell[TextData[{
 "As a consequence, the (",
 StyleBox["effective",
  FontSlant->"Italic"],
 ", or ",
 StyleBox["macroscopic",
  FontSlant->"Italic"],
 ") association constant for the tetrameric enzyme is related to the (",
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 ", or ",
 StyleBox["microscopic",
  FontSlant->"Italic"],
 ") association constant in the following way:"
}], "Text",
 CellChangeTimes->{{3.719652881573123*^9, 3.719652892045514*^9}, {
