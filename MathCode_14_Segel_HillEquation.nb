Cell[TextData[{
 "In general, for ",
 StyleBox["n",
  FontSlant->"Italic"],
 " binding sites, the ",
 StyleBox["effective ",
  FontSlant->"Italic"],
 "(",
 StyleBox["macroscopic",
  FontSlant->"Italic"],
 ") affinities (for the oligomer) of the i-th binding events are:"
}], "Text",
