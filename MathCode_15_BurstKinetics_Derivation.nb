Cell[TextData[{
 "As we want to see how much product(s) is released after time ",
 StyleBox["t",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", we define the sum of what is produced and still enzyme-bound, and the \
amount released from the enzyme:"
}], "Text",
