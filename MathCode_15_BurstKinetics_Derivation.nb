  "derivation",ExpressionUUID->"0fe6f7b0-404e-4006-884a-9f3c6988ceb3"],

Cell[TextData[{
 "What can we say about the rates? The rate of product formation is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "23"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Italic",ExpressionUUID->
  "55c52b26-73aa-4b9d-94b6-47abf9a88eae"],
 StyleBox["cEA[t] + ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "34"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Italic",ExpressionUUID->
  "0d612641-b23b-4980-945f-ad5c8c98f9b4"],
 StyleBox["cEP[t]",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.500807139952928*^9, 3.5008071539753933`*^9}, {
  3.6883667464807663`*^9, 3.68836675596723*^9}, {3.71973939856429*^9, 
  3.719739399306678*^9}, {3.753080484000679*^9, 3.753080498936638*^9}, {
  3.753081132844042*^9, 3.75308117531674*^9}},
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"b4b38d90-0fce-4b18-b437-3750a51856c5"],

Cell[BoxData[
 RowBox[{"rate", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"k23", " ", "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"cA", " ", "k12", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "cA", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "cA"}], " ", "k12"}], "-", "k21", "-", "k23", "-",
                "k34", "-", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"cA", " ", "k12"}], "+", "k21", "+", "k23", "+", 
                    "k34"}], ")"}], "2"], "-", 
                 RowBox[{"4", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"cA", " ", "k12", " ", "k23"}], "+", 
                    RowBox[{"cA", " ", "k12", " ", "k34"}], "+", 
                    RowBox[{"k21", " ", "k34"}], "+", 
                    RowBox[{"k23", " ", "k34"}]}], ")"}]}]}]]}], ")"}], " ", 
             "t"}]], " ", "k12", " ", "k23"}], "-", 
          RowBox[{"2", " ", "cA", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "cA"}], " ", "k12"}], "-", "k21", "-", "k23", "-",
                "k34", "+", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"cA", " ", "k12"}], "+", "k21", "+", "k23", "+", 
                    "k34"}], ")"}], "2"], "-", 
                 RowBox[{"4", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"cA", " ", "k12", " ", "k23"}], "+", 
                    RowBox[{"cA", " ", "k12", " ", "k34"}], "+", 
                    RowBox[{"k21", " ", "k34"}], "+", 
                    RowBox[{"k23", " ", "k34"}]}], ")"}]}]}]]}], ")"}], " ", 
             "t"}]], " ", "k12", " ", "k23"}], "+", 
          RowBox[{"cA", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "cA"}], " ", "k12"}], "-", "k21", "-", "k23", "-",
                "k34", "-", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"cA", " ", "k12"}], "+", "k21", "+", "k23", "+", 
                    "k34"}], ")"}], "2"], "-", 
                 RowBox[{"4", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"cA", " ", "k12", " ", "k23"}], "+", 
                    RowBox[{"cA", " ", "k12", " ", "k34"}], "+", 
                    RowBox[{"k21", " ", "k34"}], "+", 
                    RowBox[{"k23", " ", "k34"}]}], ")"}]}]}]]}], ")"}], " ", 
             "t"}]], " ", "k12", " ", "k34"}], "-", 
          RowBox[{"cA", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "cA"}], " ", "k12"}], "-", "k21", "-", "k23", "-",
                "k34", "+", 
