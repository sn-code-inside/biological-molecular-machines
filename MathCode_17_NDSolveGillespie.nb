                    ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"rates", "=", "\"\<SymbolicRates\>\""}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"rateSum", "=", 
                    RowBox[{"N", "@", 
                    RowBox[{"Total", "@", "rates"}]}]}], ";"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
