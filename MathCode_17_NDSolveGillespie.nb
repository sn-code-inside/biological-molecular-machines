Cell[TextData[{
 "Reference for Gillespie algorithm: ",
 ButtonBox["https://mathematica.stackexchange.com/questions/119786/gillespie-\
stochastic-simulation-algorithm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathematica.stackexchange.com/questions/119786/gillespie-\
stochastic-simulation-algorithm"], None},
  ButtonNote->
   "https://mathematica.stackexchange.com/questions/119786/gillespie-\
stochastic-simulation-algorithm"]
}], "Text",
 CellChangeTimes->{
  3.721712003444865*^9, {3.751259810265263*^9, 3.751259810267997*^9}, {
   3.977279350026568*^9, 3.977279357881366*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"1974c0be-72ae-4bb9-851d-6db6c98ba968"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "GillespieSSA", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GillespieSSA", "[", 
    RowBox[{
     RowBox[{"res", ":", 
      RowBox[{"{", "__Rule", "}"}]}], ",", "in_Association", ",", 
     RowBox[{"rateconst_", "?", "VectorQ"}], ",", 
     RowBox[{"influx_Association", ":", " ", 
      RowBox[{"<|", "|>"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mint_", "?", "NumberQ"}], ",", 
       RowBox[{"maxt_", "?", "NumberQ"}], ",", 
       RowBox[{"dstep_Integer", ":", " ", "1"}]}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vars", ",", "reactant", ",", "product", ",", "balance", ",", 
       "propensities", ",", "initialValues", ",", "fluxRates", ",", 
       "symRates", ",", "rep", ",", "stepList", ",", 
       RowBox[{"iterations", "=", 
        RowBox[{"10", "^", "7"}]}], ",", "step", ",", "compiled", ",", 
       "times", ",", "rest"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Pre", "-", 
       RowBox[{
       "generating", " ", "a", " ", "list", " ", "is", " ", "much", " ", 
        "faster", " ", "than", " ", "iteratively", " ", "calling", " ", 
        "one"}], "-", "by", "-", 
       RowBox[{"one", "."}]}], "*)"}], 
     RowBox[{
      RowBox[{"stepList", "=", 
       RowBox[{"N", "@", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"ExponentialDistribution", "@", "1"}], ",", 
          RowBox[{"iterations", "+", "1"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vars", ",", "initialValues"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Keys", "@", "in"}], ",", 
         RowBox[{"Values", "@", "in"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"reactant", ",", "product"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", "#", ",", "vars", ",",
            "1"}], "]"}], "&"}], "/@", 
        RowBox[{"Transpose", "@", 
         RowBox[{"(", 
          RowBox[{"List", "@@@", "res"}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"balance", "=", 
       RowBox[{"product", "-", "reactant"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"propensities", "=", 
       RowBox[{
        RowBox[{"Inner", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Binomial", "[", 
            RowBox[{"#2", ",", "#1"}], "]"}], "&"}], ",", "reactant", ",", 
          "vars", ",", "Times"}], "]"}], "*", 
        RowBox[{"PadRight", "[", 
         RowBox[{"rateconst", ",", 
          RowBox[{"Length", "@", "res"}], ",", "1"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fluxRates", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"influx", "===", 
          RowBox[{"<|", "|>"}]}], ",", 
         RowBox[{
          RowBox[{"0", "&"}], "/@", "vars"}], ",", 
         RowBox[{"vars", "/.", "influx"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", "count", "}"}], ",", 
        RowBox[{
         RowBox[{"rep", "=", 
          RowBox[{"Thread", "[", 
           RowBox[{"vars", "\[Rule]", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Indexed", "[", 
               RowBox[{"count", ",", "i"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "@", "vars"}]}], "}"}]}], "]"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"symRates", "=", 
          RowBox[{"propensities", "/.", "rep"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"compiled", "=", 
          RowBox[{"ReleaseHold", "[", 
           RowBox[{
            RowBox[{"Hold", "@", 
             RowBox[{"Compile", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"init", ",", "_Integer", ",", "1"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"flux", ",", "_Integer", ",", "1"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"bal", ",", "_Integer", ",", "2"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"dtList", ",", "_Real", ",", "1"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"min", ",", "_Real"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"max", ",", "_Real"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"iter", ",", "_Integer"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"resol", ",", "_Integer"}], "}"}]}], "}"}], ",", 
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"count", "=", "init"}], ",", "rates", ",", 
                   RowBox[{"i", "=", "1"}], ",", 
                   RowBox[{"c", "=", "1"}], ",", 
                   RowBox[{"t", "=", "min"}], ",", "dt", ",", "ff", ",", "f", 
                   ",", "range", ",", "r", ",", 
                   RowBox[{"fReal", "=", 
                    RowBox[{
                    RowBox[{"0.", "&"}], "/@", "flux"}]}], ",", "rateSum", ",", 
                   RowBox[{"data", "=", 
                    RowBox[{"Internal`Bag", "[", "]"}]}]}], "}"}], ",", 
                 RowBox[{
                  RowBox[{"rates", "=", "\"\<SymbolicRates\>\""}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"rateSum", "=", 
                   RowBox[{"N", "@", 
                    RowBox[{"Total", "@", "rates"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"range", "=", 
                   RowBox[{"Range", "@", 
                    RowBox[{"Length", "@", "rates"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Internal`StuffBag", "[", 
                   RowBox[{"data", ",", 
                    RowBox[{"Internal`Bag", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"{", "t", "}"}], ",", 
                    RowBox[{"N", "@", "count"}]}], "]"}], "]"}]}], "]"}], ";",
                   "\[IndentingNewLine]", 
                  RowBox[{"While", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Total", "@", "count"}], ">", "0."}], "&&", 
                    RowBox[{"rateSum", ">", "0."}], "&&", 
                    RowBox[{"t", "\[LessEqual]", "max"}], "&&", 
                    RowBox[{"i", "\[LessEqual]", "iter"}]}], ",", 
                    RowBox[{
                    RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"dt", "=", 
                    RowBox[{
                    RowBox[{"dtList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "/", "rateSum"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"t", "=", 
                    RowBox[{"t", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"r", "=", 
                    RowBox[{"RandomChoice", "[", 
                    RowBox[{"rates", "\[Rule]", "range"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Fractional", " ", "part", " ", "is", " ", "carried", " ",
                     "over", " ", "to", " ", "minimize", " ", "undersampling",
                     " ", "error"}], "*)"}], 
                    RowBox[{"ff", "=", 
