Cell[TextData[{
 "We set up equations from the partial reactions below. Note that we here use \
r4 and r5 with three participating concentrations, which in reality does not \
occur. The file ",
 StyleBox["MathCode_07_MichaelisMenten_ExtendedSystem.nb",
  FontSlant->"Italic"],
 " addresses this issue."
}], "Text",
 CellChangeTimes->{{3.7185100238466587`*^9, 3.718510042113297*^9}, {
  3.983415438611278*^9, 3.983415439956709*^9}, {3.984708432985093*^9, 
  3.984708532534988*^9}, {3.9847085655790577`*^9, 3.984708581585465*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"74f9547e-cb7e-44c2-a3ee-d07b9d78effe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r1", "=", 
   RowBox[{"k12", " ", 
    RowBox[{"cE", "[", "t", "]"}], 
    RowBox[{"cS", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r2", "=", 
   RowBox[{"k21", " ", 
    RowBox[{"cES", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r3", "=", 
   RowBox[{"k23", " ", 
    RowBox[{"cES", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r4", "=", 
   RowBox[{"k32G", " ", 
    RowBox[{"cE", "[", "t", "]"}], " ", 
    RowBox[{"cG", "[", "t", "]"}], 
    RowBox[{"cF", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r5", "=", 
   RowBox[{"k32F", " ", 
    RowBox[{"cE", "[", "t", "]"}], " ", 
    RowBox[{"cG", "[", "t", "]"}], 
    RowBox[{"cF", "[", "t", "]"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.7185082122706757`*^9, 3.7185082228768673`*^9}, {
  3.718509910477314*^9, 3.718509942376363*^9}, {3.718510301475531*^9, 
  3.718510306043934*^9}, {3.7185103872953568`*^9, 3.7185103949644823`*^9}},
 CellLabel->
  "In[141]:=",ExpressionUUID->"03adb664-0f3e-47db-ba89-adde09b99c29"],

Cell["\<\
The biochemical system requires that glucose and fuctose are always present \
at the same concentrations:  \
\>", "Text",
 CellChangeTimes->{{3.718515403135112*^9, 3.718515428680086*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"8e948658-0288-4a65-8ee9-be137bc28234"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eqEqn", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"cG", "[", "t", "]"}], "==", 
     RowBox[{"cF", "[", "t", "]"}]}], ",", 
    RowBox[{
     RowBox[{"cG", "[", "t", "]"}], "\[Equal]", 
     RowBox[{"10.", 
      RowBox[{"(*", 
       RowBox[{"cS", "[", "0", "]"}], "*)"}], "-", 
      RowBox[{"cS", "[", "t", "]"}]}]}]}], "}"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"I", " ", 
     RowBox[{"don", "'"}], "t", " ", "know", " ", "why", " ", 
     RowBox[{"cS", "[", "0", "]"}], " ", "does", " ", "not", " ", "work"}], 
    "..."}], " ", "*)"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.718515316700235*^9, 3.7185153325840693`*^9}, {
  3.7185161230564547`*^9, 3.718516129691368*^9}, {3.718516245971816*^9, 
  3.7185162512579317`*^9}, {3.718516291211177*^9, 3.718516306320706*^9}, {
  3.718516369347025*^9, 3.718516394642996*^9}, {3.71851642612362*^9, 
  3.718516505064475*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"3c9ae0ce-bae4-4f17-a93c-5ff24db3aa6d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"cG", "[", "t", "]"}], "\[Equal]", 
    RowBox[{"cF", "[", "t", "]"}]}], ",", 
   RowBox[{
