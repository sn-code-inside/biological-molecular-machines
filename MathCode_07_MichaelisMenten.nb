Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cE", "[", "t", "]"}], ",", 
         RowBox[{"cS", "[", "t", "]"}], ",", 
         RowBox[{"cES", "[", "t", "]"}], ",", 
         RowBox[{"cG", "[", "t", "]"}], ",", 
         RowBox[{"cF", "[", "t", "]"}]}], "}"}], "/.", "solFullSystem"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tEnd"}], "}"}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Full Michaelis-Menten system \\rE + S \[Equilibrium] ES \
\[Equilibrium] ... \[Equilibrium] E + F + G\>\""}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Thickness", "[", "thn", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Blue", ",", 
            RowBox[{"Thickness", "[", "thn", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
