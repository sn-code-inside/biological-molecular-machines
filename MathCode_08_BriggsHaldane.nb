Cell[TextData[{
 "In our model, the prefactor (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Enz", "total"], " ", 
    SubscriptBox["k", "23"]}], TraditionalForm]],ExpressionUUID->
  "76b82a54-5dca-44c7-9d9f-b143bffaab75"],
 ") gives the maximal reaction velocity, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "max"], TraditionalForm]],ExpressionUUID->
  "18b893b9-16b5-4ab5-92bb-2936abff2dff"],
 ". The rate constant ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "23"], TraditionalForm]],ExpressionUUID->
  "563d8bf1-1c74-42a1-9950-c981db795ca0"],
 " tells us the number of processed substrate molecules per enzyme (more \
precisely: substrate binding site)"
}], "Text",
 CellChangeTimes->{{3.4897296902904387`*^9, 3.489729830911613*^9}, 
   3.489729868908258*^9, {3.4897304304452963`*^9, 3.489730476295144*^9}, {
