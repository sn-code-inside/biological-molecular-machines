Cell[TextData[{
 "According to the assumptions of our model, the overall velocity depends \
directly on the concentration of ES and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["k", "23"], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "that", " ", "we", " ", "assume", " ", "to", " ", "be", " ", "much", " ",
          "faster", " ", "than", " ", 
         SubscriptBox["k", "12"], " ", "and", " ", 
         SubscriptBox["k", "21"]}], ")"}], ".", " ", "Thus"}], " ", "v"}], 
     " ", "=", " ", 
     RowBox[{
      SubscriptBox["k", "23"], " ", 
      SubscriptBox["c", "ES"]}]}], ",", " ", "and"}], TraditionalForm]],
  ExpressionUUID->"6bd6e653-13ce-48f1-82c1-cc9a04dc8c88"]
}], "Text",
 CellChangeTimes->{{3.4897296902904387`*^9, 3.489729830911613*^9}, 
   3.489729868908258*^9, {3.4897304304452963`*^9, 3.489730476295144*^9}, {
