Cell[TextData[{
 "If we compare this equation to the very fundamental Michaelis-Menten \
equation, we see that instead of the substrate affinity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", "S"], ","}], TraditionalForm]],ExpressionUUID->
  "7044e036-24b5-4508-903c-62584509827e"],
 " we get a new parameter, the Michaelis-Menten constant, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", "M"], ","}], TraditionalForm]],ExpressionUUID->
  "99722de2-198b-48ba-b70b-ddd51beba157"],
 " that corresponds to the ratio between ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "12"], "+", 
    RowBox[{
     SubscriptBox["k", "23"], "/", 
     SubscriptBox["k", "12"]}]}], TraditionalForm]],ExpressionUUID->
  "a3dbdac5-8a5d-4d26-91ea-1ded206c1e5d"],
 " :"
}], "Text",
 CellChangeTimes->{{3.4897296902904387`*^9, 3.489729830911613*^9}, 
   3.489729868908258*^9, {3.4897304304452963`*^9, 3.489730476295144*^9}, {
   3.4960525412553377`*^9, 3.496052596677147*^9}, {3.49605264927715*^9, 
   3.4960526574160843`*^9}, {3.68646555730505*^9, 3.686465561815671*^9}, {
