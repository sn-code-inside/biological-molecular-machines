Cell[TextData[{
 "As a second constraint, we know that at any timer the initial, total amount \
of enzyme (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Enz", "total"], TraditionalForm]],ExpressionUUID->
  "7ba11657-fd3b-4803-8104-41ca325673a0"],
 ") used in the system is present as free enzyme and substrate-bound enzyme: \
\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "Enz"], TraditionalForm]],ExpressionUUID->
  "fe0a6913-22e4-4579-86b2-af4844bc334b"],
 "\tenzyme concentration (* As Mathematica takes E as Euler's number \
\[ExponentialE] , we cannot write ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "E"], TraditionalForm]],ExpressionUUID->
  "ce5ee9e2-e77b-44af-a145-a5224e383f79"],
 " *)\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "ES"], TraditionalForm]],ExpressionUUID->
  "39ce27e1-c863-462c-bd8d-82825be0e867"],
 "\tconcentration of complex ES, and\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Enz", "total"], TraditionalForm]],ExpressionUUID->
  "c6380e12-8805-481e-9350-903227afb18e"],
 "\tinitial (= total) enzyme concentration\nIn steady state equilibrium, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "ES"], "[", "t", "]"}], ",", "t"}], "]"}], " ", "is",
     " ", 
    RowBox[{"zero", ":"}]}], TraditionalForm]],ExpressionUUID->
  "b3d27094-633c-4579-ac92-56e251ef2533"],
 " \n",
 StyleBox["(* For a dynamic treatment, see ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Gutfreund_p114ff-dynamic.nb",
  BaseStyle->"Hyperlink",
  ButtonData->{"Gutfreund_p114ff-dynamic_v2.nb", None}],
  FontSlant->"Italic"],
 StyleBox[" *)",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.4897296902904387`*^9, 3.489729830911613*^9}, 
