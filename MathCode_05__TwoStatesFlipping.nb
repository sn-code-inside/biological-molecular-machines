Cell[CellGroupData[{

Cell["Kinetic Scheme", "Section",
 CellChangeTimes->{{3.532087507576138*^9, 
  3.532087511478887*^9}},ExpressionUUID->"1a608835-9353-4190-bf6d-\
599534a03b1e"],

Cell[TextData[{
 "Given is the following system, in which one molecule flips between two \
conformations:\n  ",
 StyleBox[" ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],
  FontSize->24,ExpressionUUID->"89af29e3-9ced-4722-972a-5509061bf408"],
 StyleBox[" \[Equilibrium] ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],
  FontSize->24,ExpressionUUID->"035ac921-4ed3-40cf-bba8-d3ff01f09533"],
 "\nThis might describe a protein that can assume two states, or an enzyme \
that switches between two affinities. The concentrations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "50977fc4-af7f-412f-9c80-f55379e98eea"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "51cc379e-d1f1-4dd8-ae29-4c8fac6de450"],
 " will change with the following velocities:"
}], "Text",
 CellChangeTimes->{{3.5320872456243362`*^9, 3.532087385554812*^9}, {
  3.963286256445466*^9, 3.963286334037071*^9}, {3.9632919300252867`*^9, 
  3.9632919936168137`*^9}},
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"42166013-26dc-4e4c-98ec-5ee1b18a3694"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dgl", "=", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "k12"}], " ", 
        RowBox[{"x", "[", "t", "]"}]}], " ", "+", 
       RowBox[{"k21", " ", 
        RowBox[{"y", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", "k12"}], " ", 
        RowBox[{"x", "[", "t", "]"}]}], " ", "-", 
       RowBox[{"k21", " ", 
        RowBox[{"y", "[", "t", "]"}]}]}]}]}], "}"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.963285962567048*^9, 3.963286008347714*^9}, {
  3.9632920026828613`*^9, 3.963292004314374*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"03aa13d0-e41b-40e5-bf46-1abe6698ca55"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "d381de0b-39a1-4296-a8d2-3028a9c0feab"],
 " decreases with a rate proportional to its own concentration, and increases \
with concentration ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "67d14e6e-7153-4583-9204-9655d37a3a71"],
 ". ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "362958a3-8479-4961-9b0d-8678bddbbe68"],
 " behaves in an analogous manner.\nFor computational reasons, we \
\[OpenCurlyQuote]reduce\[CloseCurlyQuote] the system of linear differential \
equations, and compute a general solution:"
}], "Text",
 CellChangeTimes->{{3.5320872456243362`*^9, 3.532087385554812*^9}, {
  3.963286256445466*^9, 3.963286334037071*^9}, {3.9632919300252867`*^9, 
  3.963292130244453*^9}},
 FontSize->14,
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"cccf6bb1-38c7-4806-a8bc-28c96551dcaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{"dgl", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9632860303958673`*^9, 3.963286064342327*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"928536da-f421-45fa-b36c-f6cc127344ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"-", 
      RowBox[{
       SuperscriptBox["y", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}]}], "&&", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[NotEqual]", "0"}], "&&", 
    RowBox[{"k12", "\[Equal]", 
     FractionBox[
      RowBox[{
       RowBox[{"k21", " ", 
        RowBox[{"y", "[", "t", "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["y", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], 
      RowBox[{"x", "[", "t", "]"}]]}]}], ")"}], "||", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"-", 
      RowBox[{
       SuperscriptBox["y", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}]}], "&&", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Equal]", "0"}], "&&", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[NotEqual]", "0"}], "&&", 
    RowBox[{"k21", "\[Equal]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["y", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], 
       RowBox[{"y", "[", "t", "]"}]]}]}]}], ")"}], "||", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["y", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", "0"}], "&&", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", "0"}], "&&", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[Equal]", "0"}], "&&", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Equal]", "0"}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9632860446550703`*^9, 3.9632860651623707`*^9}, 
   3.974537853224112*^9, 3.977275099767859*^9, 3.9817853170295362`*^9, 
   3.984707606398856*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"ec6fccd9-e6e5-4ee5-96a6-d5e80c8e0098"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"soln", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{"dgl", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9632860713173103`*^9, 3.963286142790627*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"53a8209d-bbad-423c-a9ca-15212de5dda9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "k12"}], "-", "k21"}], ")"}], " ", "t"}]], " ", 
           "k12"}], "+", "k21"}], ")"}], " ", 
        TemplateBox[{"1"},
         "C"]}], 
       RowBox[{"k12", "+", "k21"}]], "-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "k12"}], "-", "k21"}], ")"}], " ", "t"}]]}], ")"}],
         " ", "k21", " ", 
        TemplateBox[{"2"},
         "C"]}], 
       RowBox[{"k12", "+", "k21"}]]}]}], ",", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "k12"}], "-", "k21"}], ")"}], " ", "t"}]]}], 
          ")"}], " ", "k12", " ", 
         TemplateBox[{"1"},
          "C"]}], 
        RowBox[{"k12", "+", "k21"}]]}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k12", "+", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "k12"}], "-", "k21"}], ")"}], " ", "t"}]], " ", 
           "k21"}]}], ")"}], " ", 
        TemplateBox[{"2"},
         "C"]}], 
       RowBox[{"k12", "+", "k21"}]]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.963286101771657*^9, 3.963286143522724*^9}, 
   3.974537854367566*^9, 3.977275101336782*^9, 3.981785319538681*^9, 
   3.984707607835895*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"d2f0dd32-07c8-45e4-b0bb-11c4b9b3184d"]
}, Open  ]],

Cell[TextData[{
 "The integration constants are determined by the initial concentrations, \
e.g. we start with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "a00fbd96-cccd-45bd-b80b-ae059034d1fd"],
 " only (no ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "f99cd7a8-8089-4003-9274-8a66928cf616"],
 " formed yet). Then:"
}], "Text",
 CellChangeTimes->{{3.5320872456243362`*^9, 3.532087385554812*^9}, {
