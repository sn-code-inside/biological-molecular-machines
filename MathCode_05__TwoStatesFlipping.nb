Cell[CellGroupData[{
Cell["Equilibrium between Two States", "Title",
 CellChangeTimes->{{3.5320874378106127`*^9, 3.532087448264648*^9}, {
  3.9632862008297997`*^9, 3.9632862085041656`*^9}, {3.9632867270885773`*^9, 
  3.963286730310021*^9}},ExpressionUUID->"3b6ef79d-cb48-42cd-bf4f-\
54fb37ccdd3d"],

Cell[TextData[{
 "Dynamics of flipping between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "6c1d3f5e-0dcc-471b-bb8a-429674defb92"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "da5cd1d7-d0a0-4141-83c4-b8117605cc2b"]
}], "Subtitle",
 CellChangeTimes->{{3.532087454816058*^9, 3.532087489014696*^9}, {
  3.9632862151376953`*^9, 
  3.963286233605056*^9}},ExpressionUUID->"99db7c74-52e1-4298-92c0-\
02187cf81c29"],

Cell["G. Woehlke, Aug. 2025", "Subsubsection",
 CellChangeTimes->{{3.532087494272414*^9, 3.53208750220607*^9}, {
  3.655090624215214*^9, 3.6550906269653788`*^9}, {3.718519755884433*^9, 
