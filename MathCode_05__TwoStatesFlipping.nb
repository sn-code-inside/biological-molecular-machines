Cell[BoxData[
 RowBox[{"equilibrium", "=", "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"0", "\[Equal]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "k12"}], " ", "x"}], " ", "+", 
      RowBox[{"k21", " ", "y"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"0", "\[Equal]", 
     RowBox[{
      RowBox[{
       RowBox[{"+", "k12"}], " ", "x"}], " ", "-", 
      RowBox[{"k21", " ", "y"}]}]}]}], "}"}]}]], "Input",
