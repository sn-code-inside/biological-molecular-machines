Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"BinomialDistribution", "[", 
          RowBox[{
           RowBox[{"IntegerPart", "[", "n", "]"}], ",", "p"}], "]"}], ",", 
         "m"}], "]"}], ",", "35", ",", "\"\<ProbabilityDensity\>\"", ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"FontFamily", "\[Rule]", "Arial"}], ",", "Bold", ",", 
          "fs"}], "]"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\\rnumber of steps\>\"", 
          ",", "\"\<fraction of motors\\rat #steps\>\""}], 
         RowBox[{"(*", "\"\<frequency\>\"", "*)"}], "}"}]}], ",", 
       RowBox[{"ChartStyle", "\[Rule]", 
        RowBox[{"{", "LightBlue", "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "is"}], ",", 
       RowBox[{"GridLines", "\[Rule]", "Gitter"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{
           RowBox[{"n", " ", "p"}], ",", 
           SqrtBox[
            RowBox[{"n", 
             RowBox[{"(", 
              RowBox[{"p", " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", "p"}], ")"}]}], ")"}]}]]}], "]"}], ",", 
         "x"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "/", " ", "p"}], ")"}], "1.4"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "Full"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Farbe", ",", "Dicke"}], "}"}]}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"FontFamily", "\[Rule]", "Arial"}], ",", "Bold", ",", 
          "fs"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
     RowBox[{"Epilog", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Inset", "[", 
        RowBox[{
         RowBox[{"Panel", "[", 
          RowBox[{"Style", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Number of motors: \>\"", ",", "m"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Number of time slots: \>\"", ",", "n"}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Stepping probility/\[CapitalDelta]t: \>\"", ",", 
                "p"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Mean (theory): \>\"", ",", 
                RowBox[{"n", "  ", "p"}]}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Variance (theory): \>\"", ",", 
                RowBox[{"n", " ", 
                 RowBox[{"(", 
