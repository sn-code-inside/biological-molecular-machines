  3.9820524536354723`*^9, 3.982052467037819*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"f7e029de-5b10-4656-a611-317100423505"],

Cell[TextData[{
 "The probability density function ",
 StyleBox["PDF[...,k]", "Code"],
 " displays the probabilities of finding motors that have travelled ",
 StyleBox["k",
  FontSlant->"Italic"],
 " steps after 40 time intervals."
}], "Text",
 CellChangeTimes->{{3.917259444186783*^9, 3.9172595171090813`*^9}, {
  3.917259759271021*^9, 3.917259824898246*^9}, {3.9172598827635202`*^9, 
