Cell[TextData[{
 "Importantly, the ",
 StyleBox["ratio",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of mean travel distance and its variance will stay fixed for a given \
probability (assuming one rate-limiting step). "
}], "Text",
