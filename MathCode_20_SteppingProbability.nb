7ca9f0507cdf"],

Cell[TextData[{
 "A large number of ",
 "independent motor proteins that have the probability p to step forwards in \
the interval \[CapitalDelta]t will be distributed according to a binomial \
distribution, in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " syntax ",
 StyleBox["BinomialDistribution[n,p]", "Code"],
 ". In this calculation example, the number of trials (",
 "or ",
 "time slots) is ",
 StyleBox["n",
  FontSlant->"Italic"],
 " = 40, the stepping probability per time interval is ",
 StyleBox["p",
  FontSlant->"Italic"],
 " = 0.05. Then, this function returns the probability of finding motors that \
have travelled exactly two steps:  "
}], "Text",
 CellChangeTimes->{{3.917259444186783*^9, 3.9172595171090813`*^9}, {
  3.917259759271021*^9, 3.917259824898246*^9}, {3.9172598827635202`*^9, 
  3.9172599313788557`*^9}, {3.9646799093497477`*^9, 3.964679911519939*^9}, {
  3.977371641837468*^9, 3.9773716643125553`*^9}, {3.977372155188863*^9, 
  3.97737221741086*^9}, {3.9773722600057287`*^9, 3.977372345908971*^9}, {
  3.97737239789394*^9, 3.977372425325748*^9}, {3.9773725046798363`*^9, 
  3.9773725839049*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"53448c30-0ee1-4ebe-ab15-3339e65af9e8"],

