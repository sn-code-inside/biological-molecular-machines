Cell[TextData[{
 "We find that the simulated data resembles a \[OpenCurlyDoubleQuote]Gaussian \
bell curve\[CloseCurlyDoubleQuote], formally a normal distribution (please ",
 StyleBox["update",
  FontWeight->"Bold"],
